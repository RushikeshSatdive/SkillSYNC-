{
  "name": "skillsync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SkillSync - AI-powered student skill-matching network. Frontend-only prototype.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:render": "esbuild scripts/ssr-check.jsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.cache/render.cjs --loader:.css=empty --log-level=error && node .cache/render.cjs",
    "check:interactions": "esbuild scripts/interaction-check.jsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.cache/interactions.cjs --loader:.css=empty --external:jsdom --log-level=error && node .cache/interactions.cjs",
    "check": "npm run check:data && npm run check:render && npm run check:content && npm run check:interactions && npm run check:single",
    "check:data": "node scripts/data-check.mjs",
    "check:content": "esbuild scripts/content-check.jsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.cache/content.cjs --log-level=error && node .cache/content.cjs",
    "build:single": "VITE_HASH_ROUTER=1 vite build --outDir dist-single && node scripts/build-single-file.mjs",
    "check:single": "node scripts/single-file-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "playwright": "^1.48.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
